{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dollhouse-beta-intake",
  "main": "worker.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  // REVIEW CONFIG: disabled until Mick sets up the resources and approves launch.
  // No routes are attached by this example configuration.
  "vars": {
    "BETA_REQUESTS_ENABLED": "false",
    "PUBLIC_ORIGIN": "https://dollhousemcp.com",
    "ZULIP_ORIGIN": "https://zulip.example.invalid",
    "ZULIP_STREAM_ID": "0",
    "ZULIP_TOPIC": "Hosted beta requests"
  },
  "d1_databases": [{
    "binding": "BETA_DB",
    "database_name": "dollhouse-beta-requests",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["0 6 * * *"] }
  // Create secrets separately: RATE_LIMIT_SECRET, ZULIP_BOT_EMAIL, ZULIP_API_KEY.
  // After approval, attach only dollhousemcp.com/api/beta-request* in the owned zone.
}
